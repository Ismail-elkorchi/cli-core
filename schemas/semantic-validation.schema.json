{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:semantic-validation:v1",
  "title": "cli-core Semantic Validation Result",
  "type": "object",
  "required": ["ok", "diagnostics"],
  "properties": {
    "ok": { "type": "boolean" },
    "diagnostics": { "type": "array", "items": { "type": "object", "required": ["code", "severity", "message", "fields"] } }
  },
  "additionalProperties": true
}
