{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:redaction-report:v1",
  "title": "cli-core Redaction Report",
  "type": "object",
  "required": ["schemaVersion", "value", "redacted", "matches"],
  "properties": {
    "schemaVersion": { "const": "cli-core.redaction.v1" },
    "value": {},
    "redacted": { "type": "boolean" },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "enum": ["sensitive_key", "string_pattern", "circular_reference", "max_depth"] },
          "key": { "type": "string" },
          "pattern": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
