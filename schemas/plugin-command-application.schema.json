{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:plugin-command-application:v1",
  "title": "cli-core Plugin Command Application",
  "type": "object",
  "required": ["schemaVersion", "ok", "definition", "program", "contributions", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "cli-core.plugin-command-application.v1" },
    "ok": { "type": "boolean" },
    "definition": { "type": "object", "required": ["name"] },
    "program": { "type": "object", "required": ["schemaVersion", "name", "root", "commands", "pathIndex", "aliasIndex", "diagnostics"] },
    "contributions": { "type": "array", "items": { "type": "object", "required": ["pluginName", "pluginVersion", "commandPaths", "aliasPaths"] } },
    "diagnostics": { "type": "array", "items": { "type": "object", "required": ["code", "severity", "message", "fields"] } }
  },
  "additionalProperties": true
}
