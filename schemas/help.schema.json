{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:help:v1",
  "title": "cli-core Help Document",
  "type": "object",
  "required": ["schemaVersion", "programName", "commandPath", "usage", "commands", "positionals", "options"],
  "properties": {
    "schemaVersion": { "const": "cli-core.help.v1" },
    "programName": { "type": "string" },
    "commandPath": { "type": "array", "items": { "type": "string" } },
    "usage": { "type": "string" },
    "summary": { "type": "string" },
    "commands": { "type": "array", "items": { "type": "object", "required": ["name", "path", "aliases", "source"] } },
    "positionals": { "type": "array", "items": { "type": "object", "required": ["name", "required", "variadic", "label"] } },
    "options": { "type": "array", "items": { "type": "object", "required": ["name", "flags", "type", "required", "scope"] } }
  },
  "additionalProperties": true
}
