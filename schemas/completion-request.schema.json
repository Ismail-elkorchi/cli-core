{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:completion-request:v1",
  "title": "cli-core Completion Request",
  "type": "object",
  "required": ["schemaVersion", "words", "currentWord", "cursor", "includeHidden", "protocol"],
  "properties": {
    "schemaVersion": { "const": "cli-core.completion-request.v1" },
    "words": { "type": "array", "items": { "type": "string" } },
    "currentWord": { "type": "string" },
    "cursor": { "type": "integer", "minimum": 0 },
    "includeHidden": { "type": "boolean" },
    "protocol": { "type": "object", "required": ["schemaVersion", "commandName", "argvSeparator", "request", "response"] }
  },
  "additionalProperties": true
}
