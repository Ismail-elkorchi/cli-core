{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:effect-application-report:v1",
  "title": "cli-core Effect Application Report",
  "type": "object",
  "required": ["schemaVersion", "mode", "ok", "reports", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "cli-core.effect-application.v1" },
    "mode": { "enum": ["plan", "apply"] },
    "ok": { "type": "boolean" },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["effect", "status", "payload", "diagnostics"],
        "properties": {
          "effect": { "type": "object", "required": ["kind"] },
          "status": { "enum": ["planned", "applied", "denied", "failed"] },
          "payload": {},
          "diagnostics": { "type": "array", "items": { "type": "object", "required": ["code", "severity", "message", "fields"] } }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": { "type": "array", "items": { "type": "object", "required": ["code", "severity", "message", "fields"] } }
  },
  "additionalProperties": false
}
