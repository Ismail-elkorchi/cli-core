{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:run-event:v1",
  "title": "cli-core Run Event",
  "type": "object",
  "required": ["schemaVersion", "runId", "sequence", "name", "payload"],
  "properties": {
    "schemaVersion": { "const": "cli-core.run-event.v1" },
    "runId": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 0 },
    "name": {
      "enum": [
        "parse.completed",
        "config.resolved",
        "validation.completed",
        "run.started",
        "run.planned",
        "run.applied",
        "run.skipped",
        "effects.planned",
        "run.failed",
        "plugin.hooks.planned",
        "plugin.hooks.completed",
        "run.completed"
      ]
    },
    "payload": {}
  },
  "additionalProperties": true
}
