{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:program:v1",
  "title": "cli-core Program",
  "type": "object",
  "required": ["schemaVersion", "name", "root", "commands", "pathIndex", "aliasIndex", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "cli-core.program.v1" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "root": { "type": "object", "required": ["id", "name", "path", "source", "positionals", "options", "inheritedOptions", "allowPassThrough"] },
    "commands": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "name", "path", "source", "positionals", "options", "inheritedOptions", "allowPassThrough"] }
    },
    "pathIndex": { "type": "array", "items": { "type": "object", "required": ["path", "commandId"] } },
    "aliasIndex": { "type": "array", "items": { "type": "object", "required": ["path", "commandId", "alias"] } },
    "diagnostics": { "type": "array", "items": { "type": "object", "required": ["code", "severity", "message", "fields"] } }
  },
  "additionalProperties": true
}
