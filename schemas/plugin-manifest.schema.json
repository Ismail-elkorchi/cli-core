{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:plugin-manifest:v1",
  "title": "cli-core Plugin Manifest",
  "type": "object",
  "required": ["schemaVersion", "name", "version", "cliCore", "runtimes", "capabilities", "commands", "hooks"],
  "properties": {
    "schemaVersion": { "const": "cli-core.plugin.v1" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "cliCore": { "type": "object" },
    "runtimes": { "type": "array", "items": { "enum": ["node", "deno", "bun"] } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "commands": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "hooks": { "type": "array", "items": { "type": "object", "required": ["name", "event", "order", "before", "after"] } }
  },
  "additionalProperties": true
}
