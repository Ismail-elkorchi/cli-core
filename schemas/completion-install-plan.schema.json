{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:completion-install-plan:v1",
  "title": "cli-core Completion Install Plan",
  "type": "object",
  "required": ["schemaVersion", "shell", "programName", "steps"],
  "properties": {
    "schemaVersion": { "const": "cli-core.completion-install-plan.v1" },
    "shell": { "enum": ["bash", "zsh", "fish", "pwsh"] },
    "programName": { "type": "string" },
    "steps": { "type": "array", "items": { "type": "object", "required": ["action", "path", "description"] } }
  },
  "additionalProperties": true
}
