{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:config-discovery:v1",
  "title": "cli-core Config Discovery Collection",
  "type": "object",
  "required": ["schemaVersion", "ok", "input", "files", "env", "discovery", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "cli-core.config-discovery.v1" },
    "ok": { "type": "boolean" },
    "input": { "type": "object" },
    "files": { "type": "array", "items": { "type": "object", "required": ["path", "values"] } },
    "env": { "type": "object" },
    "discovery": { "type": "object", "required": ["scope", "searchedPaths"] },
    "diagnostics": { "type": "array", "items": { "type": "object", "required": ["code", "severity", "message", "fields"] } }
  },
  "additionalProperties": true
}
