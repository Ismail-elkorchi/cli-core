{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:command-manifest:v1",
  "title": "cli-core Command Manifest",
  "type": "object",
  "required": ["schemaVersion", "package", "program", "commands", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "cli-core.manifest.v1" },
    "package": { "type": "object", "required": ["name", "version", "contractVersion"] },
    "program": { "type": "object", "required": ["name"] },
    "commands": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "name", "path", "aliases", "source", "positionals", "options", "inheritedOptions", "allowPassThrough"] }
    },
    "diagnostics": { "type": "array", "items": { "type": "object", "required": ["code", "severity", "message", "fields"] } }
  },
  "additionalProperties": true
}
