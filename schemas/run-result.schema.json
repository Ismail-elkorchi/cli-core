{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ismail-elkorchi:cli-core:schema:run-result:v1",
  "title": "cli-core Run Result",
  "type": "object",
  "required": ["schemaVersion", "runId", "mode", "invocation", "ok", "exitKind", "exitStatus", "events", "effects", "artifacts", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "cli-core.run-result.v1" },
    "runId": { "type": "string" },
    "mode": { "enum": ["plan", "apply"] },
    "invocation": { "type": "object", "required": ["schemaVersion", "ok", "argv", "commandPath"] },
    "ok": { "type": "boolean" },
    "exitKind": {
      "enum": [
        "ok",
        "parse_error",
        "config_error",
        "validation_error",
        "policy_denied",
        "cancelled",
        "interrupted",
        "timeout",
        "external_error",
        "internal_error"
      ]
    },
    "exitStatus": { "type": "integer" },
    "events": { "type": "array", "items": { "$ref": "#/$defs/runEvent" } },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/runEffect" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "runEvent": {
      "type": "object",
      "required": ["schemaVersion", "runId", "sequence", "name", "payload"],
      "properties": {
        "schemaVersion": { "const": "cli-core.run-event.v1" },
        "runId": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "name": {
          "enum": [
            "parse.completed",
            "config.resolved",
            "validation.completed",
            "run.started",
            "run.planned",
            "run.applied",
            "run.skipped",
            "effects.planned",
            "run.failed",
            "plugin.hooks.planned",
            "plugin.hooks.completed",
            "run.completed"
          ]
        }
      }
    },
    "runEffect": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["spawn", "write_file", "delete_path", "plugin", "custom"] }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "kind", "payload"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message", "fields"],
      "properties": {
        "code": { "type": "string", "pattern": "^CLI_" },
        "severity": { "enum": ["error", "warning"] },
        "message": { "type": "string" },
        "fields": { "type": "object" }
      }
    }
  },
  "additionalProperties": true
}
