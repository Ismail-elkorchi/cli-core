{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node scripts/run-mutation-tests.mjs"
  },
  "buildCommand": "npm run build",
  "mutate": [
    "src/**/*.ts",
    "!src/package.ts"
  ],
  "ignorePatterns": [
    "/dist"
  ],
  "coverageAnalysis": "off",
  "concurrency": "50%",
  "timeoutMS": 10000,
  "dryRunTimeoutMinutes": 2,
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "cleanTempDir": "always"
}
