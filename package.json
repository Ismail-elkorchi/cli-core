{
  "name": "@ismail-elkorchi/cli-core",
  "version": "0.2.0",
  "description": "Parser-independent command routing, help, completion, and dispatch primitives.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/rewrite-declaration-imports.mjs",
    "prepack": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json",
    "test": "npm run build && node --test tests/core/*.test.mjs",
    "test:package": "node --test tests/package/*.test.mjs",
    "test:mutation": "stryker run",
    "check:runtime": "deno check src/index.ts && deno lint src tests/runtime-smoke.mjs && deno test tests/runtime-smoke.mjs && bun tests/runtime-smoke.mjs",
    "check:jsr": "deno publish --dry-run --allow-dirty",
    "check:workflow-policy": "node scripts/workflow-policy-check.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "check": "npm run check:workflow-policy && npm run lint && npm run typecheck && npm test && npm run test:package && npm run check:runtime && npm run check:jsr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ismail-elkorchi/cli-core.git"
  },
  "keywords": [
    "cli",
    "command-line",
    "command-router",
    "command-tree",
    "subcommands",
    "command-dispatch",
    "command-model",
    "help",
    "autocomplete",
    "completion",
    "typescript",
    "esm",
    "node",
    "deno",
    "bun"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Ismail El Korchi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ismail-elkorchi/cli-core/issues"
  },
  "homepage": "https://github.com/Ismail-elkorchi/cli-core#readme",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "qs": "6.15.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3"
  }
}
