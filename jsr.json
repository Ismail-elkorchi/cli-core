{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@ismail-elkorchi/cli-core",
  "version": "0.1.0",
  "exports": {
    ".": "./src/index.ts",
    "./command": "./src/command/public.ts",
    "./adapter": "./src/adapter/index.ts",
    "./help": "./src/help/index.ts",
    "./completion": "./src/completion/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./config": "./src/config/index.ts",
    "./effects": "./src/effects/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./repair": "./src/repair/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing/index.ts",
    "./schemas": "./schemas/index.json",
    "./schemas/artifact.schema.json": "./schemas/artifact.schema.json",
    "./schemas/command-manifest.schema.json": "./schemas/command-manifest.schema.json",
    "./schemas/completion-command.schema.json": "./schemas/completion-command.schema.json",
    "./schemas/completion-install-plan.schema.json": "./schemas/completion-install-plan.schema.json",
    "./schemas/completion-payload.schema.json": "./schemas/completion-payload.schema.json",
    "./schemas/completion-protocol.schema.json": "./schemas/completion-protocol.schema.json",
    "./schemas/completion-request.schema.json": "./schemas/completion-request.schema.json",
    "./schemas/completion-response.schema.json": "./schemas/completion-response.schema.json",
    "./schemas/completion-script.schema.json": "./schemas/completion-script.schema.json",
    "./schemas/config-discovery.schema.json": "./schemas/config-discovery.schema.json",
    "./schemas/config-resolution.schema.json": "./schemas/config-resolution.schema.json",
    "./schemas/diagnostic.schema.json": "./schemas/diagnostic.schema.json",
    "./schemas/effect-application-report.schema.json": "./schemas/effect-application-report.schema.json",
    "./schemas/failure-envelope.schema.json": "./schemas/failure-envelope.schema.json",
    "./schemas/help.schema.json": "./schemas/help.schema.json",
    "./schemas/invocation.schema.json": "./schemas/invocation.schema.json",
    "./schemas/plugin-command-application.schema.json": "./schemas/plugin-command-application.schema.json",
    "./schemas/plugin-manifest.schema.json": "./schemas/plugin-manifest.schema.json",
    "./schemas/program.schema.json": "./schemas/program.schema.json",
    "./schemas/redaction-report.schema.json": "./schemas/redaction-report.schema.json",
    "./schemas/repair-suggestions.schema.json": "./schemas/repair-suggestions.schema.json",
    "./schemas/run-effect.schema.json": "./schemas/run-effect.schema.json",
    "./schemas/run-event.schema.json": "./schemas/run-event.schema.json",
    "./schemas/run-result.schema.json": "./schemas/run-result.schema.json",
    "./schemas/schema-envelope.schema.json": "./schemas/schema-envelope.schema.json",
    "./schemas/semantic-validation.schema.json": "./schemas/semantic-validation.schema.json",
    "./schemas/version.schema.json": "./schemas/version.schema.json"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "schemas/**/*.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "package.json"
    ]
  }
}
